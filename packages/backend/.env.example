# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Public URL for server (used in socket.io, etc)
PUBLIC_BASE_URL=http://localhost:3000

# Socket.io Configuration
RECONNECT_TIMEOUT_MS=30000
DEDUPE_WINDOW_MS=15000
ROOM_SWEEP_INTERVAL_MS=5000

# JWT Configuration
# IMPORTANT: Generate a strong secret key in production
# Minimum 32 characters recommended
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-key-here-at-least-32-characters-long

# Token Expiration Times
# Examples: "7d", "24h", "30d", "1h"
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# PostgreSQL Database Configuration
# Format: postgres://username:password@host:port/database
# For development, ensure PostgreSQL is running with:
#   createdb squarexo
#   psql squarexo < packages/backend/src/db/schema.sql
DATABASE_URL=postgres://postgres:postgres@localhost:5432/squarexo
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
